<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Knapcode.FactorioTools</RootNamespace>
    <AssemblyName>Knapcode.FactorioTools.Test</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <UseVerify Condition="'$(UseVerify)' == ''">true</UseVerify>
    <DefineConstants Condition="'$(UseVerify)' == 'true'">$(DefineConstants);USE_VERIFY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\FactorioTools\CollectionExtensions.cs" Link="CollectionExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!--
      The Verify family must move together, and it is only free to move because this
      project is on xunit v3.

      History, so the coupling is not rediscovered the hard way: this used to be
      xunit 2.9.3 + Verify.Xunit, with Verify.DiffPlex held at 3.1.2. Verify.Xunit is
      the xunit *v2* integration and its final release is 31.12.5, which depends on
      Verify core 31.12.5 with include="All", while core had moved on. Every
      Verify.DiffPlex above 3.1.2 wanted a newer core than Verify.Xunit could consume,
      so bumping it built with zero warnings and then failed at *runtime* - 2748 of
      4261 tests with "System.MethodAccessException : Attempt by method
      'VerifyXunit.Verifier.Verify(...)' to access method
      'Guards.AgainstBadSourceFile(System.String)' failed."

      So: a green build is not evidence for this stack. If these versions are ever
      changed, run the suite, and keep Verify.XunitV3 and Verify.DiffPlex aligned on
      the same Verify core rather than bumping one alone.
    -->
    <PackageReference Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageReference Include="Verify.XunitV3" Version="31.28.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FactorioTools.Serialization\FactorioTools.Serialization.csproj" />
    <ProjectReference Include="..\..\src\FactorioTools.Contract\FactorioTools.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="OilField\small-list.txt">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
