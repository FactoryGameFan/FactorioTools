<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Records the C# JSON contract (PlanOrchestrator.PlanJson / NormalizeJson) and
    GridToBlueprintString as fixtures for the Rust port (#138). Not part of
    FactorioTools.sln, so a solution build or test run never builds it. Run it with
    ./docker-build.sh; see rust/contract/FIXTURES.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Knapcode.FactorioTools.ContractOracle</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FactorioTools.Contract\FactorioTools.Contract.csproj" />
  </ItemGroup>

</Project>
