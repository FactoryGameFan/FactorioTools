<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- AOT on, but only pays off together with LocationAsStruct=false, which
         `npm run build-wasm` passes on the command line. It cannot live here:
         it is a global property that must reach the referenced projects, and
         a property set in this file does not. With Location as a struct, Mono's
         AOT falls back to the interpreter for generic code over it and plans
         14x slower than native; as a class, 4.3x. See issue #139. -->
    <RunAOTCompilation>true</RunAOTCompilation>

    <WasmEnableES6>true</WasmEnableES6>
    
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  
  <PropertyGroup>
    <RootNamespace>Knapcode.FactorioTools.BrowserWasm</RootNamespace>
    <AssemblyName>Knapcode.FactorioTools.BrowserWasm</AssemblyName>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\FactorioTools.Serialization\FactorioTools.Serialization.csproj" />
    <ProjectReference Include="..\FactorioTools.Contract\FactorioTools.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="index.html" />
    <WasmExtraFilesToDeploy Include="main-node.js" />
    <WasmExtraFilesToDeploy Include="main.js" />
  </ItemGroup>
</Project>
