<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Records what FluteSharp does, so the Rust port in rust/flute can be checked without
    .NET (#138). Not part of FactorioTools.sln. See ../FIXTURES.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FactorioTools.Serialization\FactorioTools.Serialization.csproj" />
  </ItemGroup>
</Project>
