<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Records how .NET's collections, sorts and rounding behave, so the Rust port (#138) can be
    checked against real .NET without needing .NET. See ../FIXTURES.md. Not part of
    FactorioTools.sln, so a solution build or test does not touch it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
