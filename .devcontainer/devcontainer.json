// A Linux container for the whole dev loop: the Rust planner (cargo build and
// test in rust/, and the WASM build the site loads) and the Vue front-end.
// CLAUDE.md's "Devcontainer" section says what it covers and what still needs
// the host - the Factorio oracle capture.
//
// The Dockerfile carries the Rust toolchain rust/rust-toolchain.toml pins,
// already installed, and an exact, checksummed Node.
{
    "name": "FactorioTools",
    "build": { "dockerfile": "Dockerfile" },
    // uid 1000 in the base image, so bind-mounted files are not root-owned.
    "remoteUser": "ubuntu",
    "mounts": [
        // src/vue/node_modules holds platform-native binaries - esbuild,
        // @parcel/watcher, fsevents on a Mac. Sharing the host's copy would
        // leave whichever side installed last broken for the other, so the
        // container gets its own.
        {
            "source": "factoriotools-vue-node-modules-${devcontainerId}",
            "target": "${containerWorkspaceFolder}/src/vue/node_modules",
            "type": "volume"
        },
        // rust/target is the same problem as node_modules: Linux build output
        // in the bind mount would sit beside, and invalidate, a Mac host's own
        // cargo builds. A volume keeps them apart and survives a rebuild.
        {
            "source": "factoriotools-rust-target-${devcontainerId}",
            "target": "${containerWorkspaceFolder}/rust/target",
            "type": "volume"
        },
        // The crates.io index and downloaded crates, so a rebuilt container
        // does not fetch them again. Only these two folders of CARGO_HOME:
        // its bin/ holds rustup and cargo from the image, and a volume over
        // all of it would keep serving the old ones after an image update.
        {
            "source": "factoriotools-cargo-registry-${devcontainerId}",
            "target": "/home/ubuntu/.cargo/registry",
            "type": "volume"
        },
        {
            "source": "factoriotools-cargo-git-${devcontainerId}",
            "target": "/home/ubuntu/.cargo/git",
            "type": "volume"
        }
    ],
    // Vite's dev server. Reaching it from the host needs `--host`, and that is
    // not optional - see the Devcontainer section in CLAUDE.md for the
    // measurement. Vite's default binds localhost only, and a port forwarder
    // dialling 127.0.0.1 gets a connection reset.
    "forwardPorts": [5173],
    "portsAttributes": {
        "5173": { "label": "Vite (needs --host)" }
    },
    // A new volume is root-owned, hence the chown.
    // The safe.directory line is a no-op under OrbStack, where the mount already
    // appears owned by uid 1000; it is insurance on a Linux host whose own uid
    // is not 1000, where git otherwise refuses with "dubious ownership" and
    // vite.config.ts's `git describe` call takes the build down with it.
    // build-wasm runs last because the Vite build and `npm run dev` import the
    // planner it produces, and fail without it. It is a release build of the
    // planner and its dependencies, so it is the slow step here; the
    // Devcontainer section in CLAUDE.md has the measured time.
    "postCreateCommand": "sudo chown ubuntu:ubuntu src/vue/node_modules rust/target /home/ubuntu/.cargo/registry /home/ubuntu/.cargo/git && git config --global --add safe.directory \"${containerWorkspaceFolder}\" && npm --prefix src/vue ci && npm --prefix src/vue run build-wasm",
    "customizations": {
        "vscode": {
            "extensions": ["rust-lang.rust-analyzer", "Vue.volar"],
            "settings": {
                // The Cargo workspace is in rust/, not at the repository root.
                "rust-analyzer.linkedProjects": ["rust/Cargo.toml"]
            }
        }
    }
}
